<Window x:Class="HebrewTaskbarWidget.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תאריכון"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- כפתור מעוגל, תואם לעיצוב שאר התוכנה - ברירת מחדל (משני) ומודגש (ראשי) -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#1A5FB4" />
            <Setter Property="BorderBrush" Value="#1A5FB4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- פס גלילה מודרני (זהה בעיצובו לזה שבפאנל ההגדרות) - נחוץ רק
             במצב "גלילה גדולה" (ראו AppMessageBoxWindow.Show), כשתוכן
             ההודעה (למשל "מה חדש בגרסה זו") ארוך מדי מכדי להיכנס בבת אחת. -->
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8A8B90" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5B5D63" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#00000000" />

        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Border CornerRadius="4" Background="{DynamicResource ScrollTrackBrush}" />
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Width="8">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}" MinHeight="30" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            BorderThickness="1"
            MinWidth="320"
            MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Margin="22,22,22,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="IconText" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <!-- במצב הרגיל (ברירת המחדל) ה-ScrollViewer הזה פשוט לא
                     משפיע על כלום - בלי MaxHeight מפורש הוא גדל בדיוק כמו
                     TextBlock רגיל, בלי פס גלילה כלל (אין גלישה להציג).
                     רק במצב "גלילה גדולה" (ראו קוד ה-Code-Behind) מוגדר לו
                     MaxHeight, ואז הוא הופך בפועל לאזור גלילה. -->
                <ScrollViewer x:Name="MessageScrollViewer" Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" LineHeight="19" />
                </ScrollViewer>

                <!-- תוכן ארוך ומובנה (כמו "מה חדש בגרסה זו") מוצג דרך זה
                     במקום ה-ScrollViewer/TextBlock הרגילים למעלה - ראו
                     AppMessageBoxWindow.xaml.cs (largeScrollable, BuildReleaseNotesDocument).
                     FlowDocument תומך ב-RTL וברשימות-תבליטים באופן טבעי
                     ונכון (כולל הזחה תלויה לשורות עטופות) - בניגוד ל-
                     TextBlock פשוט, שאין לו מושג "פסקה"/"פריט רשימה" בכלל. -->
                <FlowDocumentScrollViewer x:Name="MessageFlowViewer" Margin="0,14,0,0"
                                          FlowDirection="RightToLeft"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="Collapsed" Padding="0" />
            </StackPanel>

            <Border x:Name="ButtonAreaBorder" BorderThickness="0,1,0,0">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,14,16,14" />
            </Border>
        </StackPanel>
    </Border>
</Window>

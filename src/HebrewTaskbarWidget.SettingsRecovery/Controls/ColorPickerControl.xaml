<UserControl x:Class="HebrewTaskbarWidget.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignWidth="280">

    <!-- בורר צבע מבוסס-חלונית קופצת: בשורה הראשית מוצג רק מתג "בחר צבע"
         וקוביית תצוגה מקדימה של הצבע הנבחר; כל בורר הצבע המלא (לוח
         גוון/רוויה/בהירות, מחוון גוון, קוד הצבע, ודוגמיות הערכה המוכנות)
         עובר לחלונית קופצת (Popup) שנפתחת בלחיצה על המתג - כדי לשמור על
         מראה נקי ומוכר יותר (בדומה לבוררי צבע סטנדרטיים) בפאנל ההגדרות
         עצמו, שם בעבר הוצג לוח הדוגמיות המלא תמיד "פתוח" בכל שורה. -->
    <StackPanel>
        <!-- כל הצבעים/סגנונות שמוגדרים כאן משתמשים ב-DynamicResource כדי
             להמשיך ולהגיב לערכת הנושא (בהיר/כהה) של פאנל ההגדרות המארח -
             ה-DynamicResource נפתר בזמן ריצה, אחרי שהבקרה מצטרפת לעץ
             הלוגי של החלון המארח, ולכן מסוגל "לראות" את המשאבים המוגדרים
             שם (SettingsWindow.xaml) גם שהם לא ידועים בזמן בניית ה-XAML
             של הבקרה הזו עצמה. -->
        <StackPanel.Resources>
            <Style x:Key="ColorPickerToggleStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentForegroundBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentForegroundBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- שדות טקסט קטנים (קוד צבע + RGB) בחלונית הקופצת - עוצבו מחדש
                 בקצוות מעוגלים, תואם לעיצוב המודרני שכבר חל על שאר שדות
                 הטקסט בפאנל ההגדרות הראשי (SettingsWindow.xaml). מוגדר כאן
                 באופן עצמאי (עם ControlTemplate מלא, לא רק Setters) כי
                 UserControl זה נטען לפעמים גם מחוץ להקשר של SettingsWindow -
                 לא רוצים להסתמך על סגנון TextBox גלובלי שמוגדר במקום אחר. -->
            <Style x:Key="ColorPickerSmallTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="3,3" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </StackPanel.Resources>

        <!-- שורת ההפעלה: מתג "בחר צבע" + קוביית תצוגה מקדימה של הצבע שנבחר.
             קוד הצבע (הקסדצימלי) אינו מוצג כאן יותר - הוא מוצג רק בתוך
             החלונית הקטנה הקופצת (ראו HexCodeTextBox למטה), כדי לא לשכפל
             את אותו מידע פעמיים בפאנל ההגדרות הראשי. -->
        <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="PickerToggleButton" Content="בחר צבע" Style="{StaticResource ColorPickerToggleStyle}"
                          Click="PickerToggleButton_Click" />
            <Border x:Name="PreviewSwatchBorder" Width="26" Height="26" Margin="8,0,0,0" CornerRadius="6"
                    BorderThickness="1" BorderBrush="{DynamicResource ControlBorderBrush}" VerticalAlignment="Center"
                    Cursor="Hand" MouseLeftButtonUp="PreviewSwatchBorder_MouseLeftButtonUp">
                <Border.Background>
                    <SolidColorBrush x:Name="PreviewBrush" Color="White" />
                </Border.Background>
            </Border>
        </StackPanel>

        <!-- חלונית הבחירה הקופצת - נפתחת מתחת למתג, נסגרת בלחיצה בכל מקום
             אחר (StaysOpen="False", כמו כל חלונית נשלטת סטנדרטית). -->
        <!-- StaysOpen="True" בכוונה - הסגירה נשלטת ידנית בקוד (ראו
             HostWindow_PreviewMouseDown ב-ColorPickerControl.xaml.cs) ולא
             דרך מנגנון ה-Dismiss המובנה (StaysOpen="False"): מנגנון זה
             סוגר Popup כבר ב-MouseDown, לפני שאירוע ה-Click של כפתור
             ההפעלה עצמו מספיק לרוץ (ב-MouseUp) - מה שגורם למירוץ שבו
             לחיצה חוזרת על הכפתור "נראית" כאילו לא עשתה כלום (החלונית
             נסגרת ואז נפתחת שוב מיידית), בדיוק כמו הבאג שתוקן בלוח
             הזמנים הראשי (ראו ZmanimPopup.xaml.cs). -->
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=PickerToggleButton}" Placement="Bottom"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Closed="PickerPopup_Closed" Opened="PickerPopup_Opened">
            <Border x:Name="PopupContentRoot" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3" Color="Black" />
                </Border.Effect>
                <StackPanel Width="236">
                    <!-- לוח גוון/רוויה/בהירות (SV) - הצירוף של שלוש שכבות
                         (צבע גוון מלא, גרדיאנט לבן->שקוף אופקי, גרדיאנט
                         שקוף->שחור אנכי) יוצר בדיוק את לוח ה-HSV הרגיל,
                         בלי צורך במניפולציית פיקסלים ידנית. -->
                    <Grid x:Name="SvCanvas" Height="140" ClipToBounds="True" Cursor="Cross"
                          MouseLeftButtonDown="SvCanvas_MouseLeftButtonDown" MouseMove="SvCanvas_MouseMove" MouseLeftButtonUp="SvCanvas_MouseLeftButtonUp">
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="SvHueLayer" Fill="Red" />
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#FF000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                        </Border>
                        <Border x:Name="SvCursor" Width="14" Height="14" CornerRadius="7" BorderThickness="2"
                                BorderBrush="White" Background="Transparent" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7,-7,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <!-- מחוון הגוון (Hue) - רצועה אופקית עם קשת הצבעים המלאה -->
                    <Grid x:Name="HueSlider" Height="16" Margin="0,8,0,0" Cursor="Hand"
                          MouseLeftButtonDown="HueSlider_MouseLeftButtonDown" MouseMove="HueSlider_MouseMove" MouseLeftButtonUp="HueSlider_MouseLeftButtonUp">
                        <Border CornerRadius="8" ClipToBounds="True">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFF0000" Offset="0.0" />
                                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                                        <GradientStop Color="#FFFF0000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Border>
                        <Border x:Name="HueCursor" Width="6" Height="20" CornerRadius="3" BorderThickness="2"
                                BorderBrush="White" Background="Transparent" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-3,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                        </Border>
                    </Grid>

                    <!-- שקיפות (Alpha) - מוצג רק כאשר ShowOpacitySlider=true (רקעים) -->
                    <StackPanel x:Name="OpacityRow" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="שקיפות:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}" Margin="0,0,6,0" />
                        <Slider x:Name="OpacitySlider" Width="150" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- קוד צבע + תצוגה מקדימה גדולה יותר -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}">
                            <Border.Background>
                                <SolidColorBrush x:Name="PopupPreviewBrush" Color="White" />
                            </Border.Background>
                        </Border>
                        <TextBox x:Name="HexCodeTextBox" Grid.Column="1" Text="#FFFFFF" FontFamily="Consolas" FontSize="12"
                                 Style="{StaticResource ColorPickerSmallTextBoxStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                 TextChanged="HexCodeTextBox_TextChanged" />
                    </Grid>

                    <!-- שדות RGB - כל שינוי תקין בכל אחד מהם (או בקוד הצבע,
                         או בלוח/מחוון הגוון) מעדכן את כל השאר -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="אדום" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            <TextBox x:Name="RedTextBox" Style="{StaticResource ColorPickerSmallTextBoxStyle}" TextChanged="RgbTextBox_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ירוק" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            <TextBox x:Name="GreenTextBox" Style="{StaticResource ColorPickerSmallTextBoxStyle}" TextChanged="RgbTextBox_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="כחול" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            <TextBox x:Name="BlueTextBox" Style="{StaticResource ColorPickerSmallTextBoxStyle}" TextChanged="RgbTextBox_TextChanged" />
                        </StackPanel>
                    </Grid>

                    <!-- דוגמיות ערכה מוכנות - זהות למה שהיה מוצג בעבר תמיד
                         בפאנל עצמו, עברו לכאן כחלק מהחלונית הקופצת. -->
                    <TextBlock Text="ערכת צבעים" FontSize="10" Margin="0,12,0,4" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    <WrapPanel x:Name="SwatchesPanel" Orientation="Horizontal" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>

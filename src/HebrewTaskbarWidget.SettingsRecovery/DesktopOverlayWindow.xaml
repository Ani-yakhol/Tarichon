<Window x:Class="HebrewTaskbarWidget.DesktopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תצוגת תאריך על שולחן העבודה"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False">

    <StackPanel x:Name="LinesPanel" Orientation="Vertical" HorizontalAlignment="Center">
        <TextBlock x:Name="DayParashaText" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="HolidayText" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" />
        <TextBlock x:Name="HebrewDateText" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" />
        <TextBlock x:Name="GregorianDateText" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" />
        <TextBlock x:Name="TimeText" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" />
    </StackPanel>
</Window>

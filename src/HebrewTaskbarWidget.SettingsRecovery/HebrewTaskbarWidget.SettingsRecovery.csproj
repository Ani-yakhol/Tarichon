<Project>

  <!--
    פרוייקט שני, קטן ונפרד: יוצר קובץ הרצה (exe) עצמאי שפותח ישירות את פאנל
    ההגדרות הרשמי של תאריכון, בלי להריץ את הוידג'ט/הטיימרים עצמם כלל.

    זוהי דרך גישה רשמית ומלאה לפאנל ההגדרות - לא רק "כלי שחזור" - המיועדת
    בפרט למקרה שבו הוידג'ט הראשי כבר רץ ברקע אך אינו נגיש/נראה על המסך
    (למשל אחרי ניתוק צג חיצוני, שינוי רזולוציה קיצוני וכו'): פתיחה מחדש של
    התוכנה הראשית לא תעזור במקרה כזה (יש כבר מופע רץ), ולכן יש צורך בישום
    נפרד שפותח ישירות את פאנל ההגדרות הרשמי, ללא תלות בגישה לוידג'ט עצמו.

    מיישם זאת ע"י הפניה (ProjectReference) לפרוייקט הראשי ושימוש ישיר במחלקת
    ה-SettingsWindow שלו - כך שאין כפילות קוד, וההגדרות (כולל כל הלוגיקה
    והאימות) תמיד זהות ב-100% לאלה שבתוכנה הראשית. שינויים שנשמרים כאן
    נכנסים לתוקף מיידית גם בוידג'ט הראשי הרץ ברקע, באמצעות איתות בין-תהליכי
    (ראו Services/CrossProcessSignal.cs).

    מגרסה 0.5.3: קובץ זה יושב באותה תיקיית קוד מקור פיזית בדיוק כמו
    הפרוייקט הראשי (HebrewTaskbarWidget.csproj) - במקום בתיקייה נפרדת כמו
    קודם - כדי לבטל כפילות תיקיות מיותרת. מכיוון שברירת המחדל של SDK-style
    csproj היא לכלול אוטומטית (glob) את כל קבצי ה-.cs/.xaml בתיקיית
    הפרוייקט, וכאן זו אותה תיקייה שמכילה גם את כל קוד המקור המשותף -
    ההכללה האוטומטית כובתה כליל למטה (Enable*Items=false), וכל מה שהפרוייקט
    הזה באמת צריך (רק שני הקבצים הייעודיים שלו, SettingsRecoveryApp.xaml
    ו-.xaml.cs) נוסף במפורש. כל שאר הקוד (כולל SettingsWindow עצמו) מגיע
    אך ורק דרך ה-ProjectReference למטה - לא מקומפל כאן פעם שנייה.

    הערה חשובה על התחביר: בניגוד לרוב קבצי ה-.csproj (שמתחילים ב-
    "<Project Sdk="Microsoft.NET.Sdk">" בשורה אחת), כאן ה-Sdk מיובא
    במפורש בשתי פקודות Import נפרדות (Sdk.props למעלה, Sdk.targets למטה)
    - כדי שאפשר יהיה להגדיר BaseIntermediateOutputPath/BaseOutputPath
    (למטה) **לפני** ש-Sdk.props נטען. זה קריטי: NuGet restore קובע את
    נתיב קבצי השחזור (project.assets.json וכו') לפי הערך הזה **כפי
    שהוא בזמן ייבוא Sdk.props** - הגדרה שלו בתוך PropertyGroup רגיל
    (שרץ אחרי הייבוא המשתמע הרגיל) מגיעה מאוחר מדי, וגורמת ל-NuGet
    לכתוב את קבצי השחזור לתיקיית ה-obj\ המשותפת עם הפרוייקט הראשי (שיושב
    באותה תיקייה פיזית) - התנגשות שמובילה לשגיאות build כמו
    "MSB3030: Could not copy file ... .nuget.dgspec.json ... not found"
    ו-"CS0006: Metadata file ... HebrewTaskbarWidget.dll could not be
    found". התחביר המפוצל הזה הוא הפתרון המתועד הרשמי של Microsoft
    בדיוק למקרה הזה (כמה פרוייקטי .csproj שחיים באותה תיקייה פיזית).
  -->

  <PropertyGroup>
    <!-- חייב להיקבע *לפני* ייבוא Sdk.props למטה - ראו הערה מפורטת למעלה. -->
    <BaseIntermediateOutputPath>obj\Settings\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\Settings\</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HebrewTaskbarWidget.SettingsRecovery</RootNamespace>
    <AssemblyName>HebrewTaskbarWidgetSettings</AssemblyName>

    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <Product>הגדרות תאריכון</Product>
    <AssemblyTitle>Tarichon - Settings</AssemblyTitle>
    <Company>Tarichon Project</Company>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- מכבה את ההכללה האוטומטית (globbing) של כל קבצי ה-.cs/.xaml
         בתיקייה - ראו הערה בראש הקובץ. הפרוייקט הזה מוסיף במפורש רק את
         שני הקבצים שהוא באמת צריך (ItemGroup למטה); כל שאר קוד המקור
         שבתיקייה שייך לפרוייקט הראשי בלבד ומגיע לכאן רק דרך ProjectReference. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- נקודת הכניסה הייעודית של הפרוייקט הזה בלבד (ראו הערה בראש הקובץ
         על שם הקובץ "SettingsRecoveryApp" ולא סתם "App"). -->
    <ApplicationDefinition Include="SettingsRecoveryApp.xaml" />
    <Compile Include="SettingsRecoveryApp.xaml.cs">
      <DependentUpon>SettingsRecoveryApp.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="HebrewTaskbarWidget.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>

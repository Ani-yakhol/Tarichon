<Window x:Class="HebrewTaskbarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תאריכון"
        Icon="Assets/app.ico"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False">

    <Window.Resources>
        <!--
            תפריט ההקשר שנפתח בלחיצה ימנית על הוידג'ט. שימו לב: אינו נפתח
            אוטומטית ע"י WPF (שמסתמך על Hit Testing פנימי שיש בו באג ידוע עם
            AllowsTransparency+PerMonitorV2) - הוא נפתח יזומה מקוד ה-C#,
            כתגובה להודעת WM_RBUTTONDOWN גולמית (ראו MainWindow.xaml.cs).
        -->
        <ContextMenu x:Key="WidgetContextMenu" FlowDirection="RightToLeft">
            <MenuItem x:Name="ZmanimMenuItem"
                      Header="זמני היום..."
                      Click="ZmanimMenuItem_Click" />
            <MenuItem x:Name="SettingsMenuItem"
                      Header="הגדרות..."
                      Click="SettingsMenuItem_Click" />
            <MenuItem x:Name="NotificationsMenuItem"
                      Header="התראות..."
                      Click="NotificationsMenuItem_Click" />
            <Separator />
            <MenuItem x:Name="AboutMenuItem"
                      Header="אודות"
                      Click="AboutMenuItem_Click" />
            <Separator />
            <MenuItem x:Name="ExitMenuItem"
                      Header="יציאה"
                      Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.Resources>

    <!--
        WidgetBackground ממלא את כל שטח החלון. שימו לב: אין כאן יותר
        Handlers של MouseLeftButtonDown/Up/Move/MouseRightButtonDown - כל
        הטיפול בלחיצה/גרירה מתבצע ברמת הודעת ה-Win32 הגולמית ב-WndProc
        (ראו הערה ב-MainWindow.xaml.cs), כדי לעקוף באג ידוע ב-Hit Testing
        הפנימי של WPF בחלונות AllowsTransparency בשילוב PerMonitorV2, שגרם
        לכך שרק חלק קטן מהוידג'ט הגיב בפועל ללחיצות.
    -->
    <Border x:Name="WidgetBackground"
            Background="#01000000"
            CornerRadius="4"
            ToolTip="תאריכון"
            ContextMenu="{StaticResource WidgetContextMenu}">

        <!-- RootLayoutPanel: שני "טורים" אפשריים - שורות התאריך העברי, ולידן
             (אופציונלי) שעון/תאריך לועזי שמחקה את התצוגה המקורית של Windows.
             סדר הילדים נקבע דינמית בקוד לפי GregorianClockSide. -->
        <StackPanel x:Name="RootLayoutPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="10,4"
                    IsHitTestVisible="False">

            <StackPanel x:Name="WidgetLinesPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- שורה עליונה: יום בשבוע + פרשת השבוע, לדוגמה: "שני, דברים" -->
                <TextBlock x:Name="TopLineText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="White"
                           Text="" />

                <!-- שורה תחתונה: התאריך העברי המלא, לדוגמה: כ"ח תמוז ה'תשפ"ו -->
                <TextBlock x:Name="BottomLineText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="White"
                           Margin="0,1,0,0"
                           Text="" />
            </StackPanel>

            <!-- מפריד דק בין שתי התצוגות - מוצג רק כאשר השעון הלועזי פעיל -->
            <Border x:Name="ClockSeparator"
                    Width="1"
                    Margin="8,1"
                    Background="#55FFFFFF"
                    Visibility="Collapsed" />

            <!-- שעון/תאריך לועזי מחקה - מוצג רק אם הופעל בהגדרות. לחיצה עליו
                 נתפסת ע"י אותו Border חיצוני (WidgetBackground) כמו כל שאר
                 הוידג'ט, ולכן פותחת בדיוק את אותה חלונית זמנים. -->
            <StackPanel x:Name="GregorianClockPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Visibility="Collapsed">

                <TextBlock x:Name="GregorianTimeText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="White"
                           Text="" />

                <TextBlock x:Name="GregorianDateText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="White"
                           Margin="0,1,0,0"
                           Text="" />
            </StackPanel>

            <!-- מפריד דק לצד חלק "חג ומועד" - מוצג רק כשהחלק הזה פעיל -->
            <Border x:Name="HolidaySeparator"
                    Width="1"
                    Margin="8,1"
                    Background="#55FFFFFF"
                    Visibility="Collapsed" />

            <!-- חלק "חג ומועד" - מוצג רק בימים שיש בהם חג/מועד, ורק אם
                 הופעל בהגדרות (כבוי כברירת מחדל). לחיצה עליו נתפסת ע"י אותו
                 Border חיצוני (WidgetBackground) כמו כל שאר הוידג'ט. -->
            <StackPanel x:Name="HolidayPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Visibility="Collapsed">

                <TextBlock x:Name="HolidayPanelText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           Foreground="White"
                           Text="" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

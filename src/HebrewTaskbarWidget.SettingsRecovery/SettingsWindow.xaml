<Window x:Class="HebrewTaskbarWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HebrewTaskbarWidget.Controls"
        Title="הגדרות - תאריכון"
        Icon="Assets/app.ico"
        FlowDirection="RightToLeft"
        Width="1000" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="12.5"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ShowInTaskbar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HebrewTaskbarWidget;component/Themes/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ניווט צדדי (ב-RTL העמודה הראשונה מוצגת מימין) -->
        <DockPanel Grid.Column="0" Grid.RowSpan="2" Margin="12,14,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,0,16">
                <Image Source="Assets/app.ico" Width="30" Height="30" VerticalAlignment="Center" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="תאריכון" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="הגדרות" FontSize="11.5" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- חיפוש בכל ההגדרות -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="SettingsSearchBox" Padding="30,3,8,3" Height="32"
                         AutomationProperties.Name="חיפוש הגדרה"
                         TextChanged="SettingsSearchBox_TextChanged" PreviewKeyDown="SettingsSearchBox_PreviewKeyDown" />
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="13" Margin="10,0,0,0"
                           HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <TextBlock x:Name="SettingsSearchPlaceholder" Text="חיפוש הגדרה" Margin="31,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SettingsSearchBox}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       Width="{Binding ActualWidth, ElementName=SettingsSearchBox}">
                    <Border CornerRadius="8" Margin="0,4,8,10" Padding="3" MaxHeight="360"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <ListBox x:Name="SearchResultsList" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonUp="SearchResultsList_PreviewMouseLeftButtonUp"
                                     KeyDown="SearchResultsList_KeyDown" />
                            <TextBlock x:Name="SearchNoResultsText" Text="לא נמצאה הגדרה מתאימה" Margin="10,8"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <ListBox x:Name="NavigationList" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="עמודי ההגדרות"
                     SelectedIndex="{Binding SelectedIndex, ElementName=MainTabControl, Mode=TwoWay}">
                <ListBoxItem Tag="&#xE718;" Content="הוידג'ט" />
                <ListBoxItem Tag="&#xE787;" Content="לוח עברי ומועדים" />
                <ListBoxItem Tag="&#xE707;" Content="מיקום וזמני היום" />
                <ListBoxItem Tag="&#xEA8F;" Content="התראות" />
                <ListBoxItem Tag="&#xE7F4;" Content="שולחן העבודה" />
                <ListBoxItem Tag="&#xE713;" Content="כללי" />
                <ListBoxItem Tag="&#xE946;" Content="אודות" />
            </ListBox>
        </DockPanel>

        <!-- אזור התוכן -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="28,22,32,10">
                <TextBlock Text="{Binding SelectedItem.Header, ElementName=MainTabControl}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedItem.Tag, ElementName=MainTabControl}" Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- הלשוניות עצמן מוסתרות; הניווט נעשה מהרשימה הצדדית, שקשורה ל-SelectedIndex. -->
            <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- עמוד 1: הוידג'ט בשורת המשימות -->
                <TabItem Header="הוידג'ט" Tag="מה מוצג ליד השעון בשורת המשימות, איפה ואיך הוא נראה">
                    <ScrollViewer x:Name="WidgetTabScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960" /></Grid.ColumnDefinitions><StackPanel Margin="28,0,32,28">
                            <controls:SettingsCard Glyph="&#xE890;" Header="הצגת הוידג'ט בשורת המשימות"
                                                   Description="כשהוא כבוי, ההתראות והתצוגה על שולחן העבודה ממשיכות לפעול כרגיל">
                                <CheckBox x:Name="ShowWidgetCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="מיקום" />
                            <controls:SettingsCard Glyph="&#xE718;" Header="מיקום הוידג'ט בשורת המשימות" Keywords="צמוד חץ מרחק קצה פיקסלים">
                                <controls:SettingsCard.Details>
                                    <StackPanel>
                                        <RadioButton x:Name="PositionChevronRadio" GroupName="PositionMode" Content="צמוד לחץ ה-^ (הצג סמלים מוסתרים) - ברירת מחדל" Checked="PositionMode_Changed" />
                                        <RadioButton x:Name="PositionCustomEdgeRadio" GroupName="PositionMode" Content="במרחק קבוע מקצה שורת המשימות" Checked="PositionMode_Changed" />
                                        <StackPanel x:Name="CustomEdgeOffsetPanel" Orientation="Horizontal" Margin="26,4,0,0">
                                            <ComboBox x:Name="CustomOffsetSideComboBox" Width="140" SelectionChanged="CustomOffsetSideComboBox_SelectionChanged">
                                                <ComboBoxItem Content="מהקצה הימני" />
                                                <ComboBoxItem Content="מהקצה השמאלי" />
                                            </ComboBox>
                                            <TextBlock Text="מרחק בפיקסלים:" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBox x:Name="CustomOffsetPixelsTextBox" Width="70" Margin="8,0,0,0" TextAlignment="Center" TextChanged="CustomOffsetPixelsTextBox_TextChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE72E;" Header="נעילת מיקום" Keywords="גרירה Ctrl"
                                                   Description="אפשר להזיז את הוידג'ט ב-Ctrl + גרירה. הנעילה מונעת הזזה בטעות.">
                                <CheckBox x:Name="LockWidgetPositionCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE8A7;" Header="מיקום לוח הזמנים" Description="היכן נפתח לוח זמני היום בלחיצה על הוידג'ט">
                                <ComboBox x:Name="ZmanimPopupAlignmentComboBox" MinWidth="240">
                                    <ComboBoxItem Content="אוטומטי - ברירת מחדל" />
                                    <ComboBoxItem Content="ממורכז מעל הוידג'ט" />
                                    <ComboBoxItem Content="מיושר לקצה הימני של הוידג'ט" />
                                    <ComboBoxItem Content="מיושר לקצה השמאלי של הוידג'ט" />
                                </ComboBox>
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="תוכן הוידג'ט" />
                            <controls:SettingsCard Glyph="&#xE787;" Header="שעה ותאריך לועזי" Description="מוצגים לצד התאריך העברי, כמו השעון של Windows" Keywords="פורמט תאריך קו מפריד">
                                <CheckBox x:Name="ShowGregorianClockCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="ShowGregorianClockCheckBox_CheckedChanged" Unchecked="ShowGregorianClockCheckBox_CheckedChanged" />
                                <controls:SettingsCard.Details>
                                    <StackPanel>
                                        <CheckBox x:Name="ShowGregorianSeparatorCheckBox" Content="קו מפריד בין העברי ללועזי" />
                                        <StackPanel x:Name="GregorianClockSidePanel" Margin="0,6,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="תבנית התאריך" />
                                                    <ComboBox x:Name="GregorianDateFormatComboBox" HorizontalAlignment="Left" MinWidth="190">
                                                        <ComboBoxItem Content="05/08/2026 - ברירת מחדל" Tag="dd/MM/yyyy" />
                                                        <ComboBoxItem Content="2026-08-05" Tag="yyyy-MM-dd" />
                                                        <ComboBoxItem Content="08/05/2026" Tag="MM/dd/yyyy" />
                                                        <ComboBoxItem Content="05.08.2026" Tag="dd.MM.yyyy" />
                                                        <ComboBoxItem Content="5.8.2026" Tag="d.M.yyyy" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="מיקום ביחס לתאריך העברי" />
                                                    <RadioButton x:Name="GregorianSideRightRadio" GroupName="GregorianSide" Content="מימין לתאריך העברי" />
                                                    <RadioButton x:Name="GregorianSideLeftRadio" GroupName="GregorianSide" Content="משמאל לתאריך העברי" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Name="WidgetHolidayCard" Glyph="&#xE734;" Header="חגים ומועדים בוידג'ט" Keywords="חג מועד קו מפריד"
                                                   Description="מוצג רק בימים שיש בהם מועד. אילו מועדים - נקבע בעמוד &quot;לוח עברי ומועדים&quot;.">
                                <CheckBox x:Name="ShowHolidayPanelCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="ShowHolidayPanelCheckBox_CheckedChanged" Unchecked="ShowHolidayPanelCheckBox_CheckedChanged" />
                                <controls:SettingsCard.Details>
                                    <StackPanel>
                                        <CheckBox x:Name="ShowHolidaySeparatorCheckBox" Content="קו מפריד לצד המועד" />
                                        <StackPanel x:Name="HolidayPanelSidePanel" Margin="0,6,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="מיקום בתוך הוידג'ט" />
                                            <RadioButton x:Name="HolidaySideRightRadio" GroupName="HolidaySide" Content="בצד הימני ביותר" />
                                            <RadioButton x:Name="HolidaySideLeftRadio" GroupName="HolidaySide" Content="בצד השמאלי ביותר" />
                                            <RadioButton x:Name="HolidaySideBetweenRadio" GroupName="HolidaySide" Content="בין העברי ללועזי" />
                                        </StackPanel>
                                        <TextBlock Margin="0,8,0,0">
                                            <Hyperlink Style="{StaticResource LinkTextStyle}" Click="GoToCalendarPage_Click">לבחירת המועדים שיוצגו</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="השעון של Windows" />
                            <controls:SettingsCard Glyph="&#xE917;" Header="הסתרת התאריך והשעה של Windows" Keywords="Explorer רווח צמצום">
                                <CheckBox x:Name="HideWindowsClockCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HideWindowsClockCheckBox_CheckedChanged" Unchecked="HideWindowsClockCheckBox_CheckedChanged" />
                                <controls:SettingsCard.Details>
                                    <StackPanel x:Name="ReduceGapPanel">
                                        <CheckBox x:Name="ReduceGapCheckBox" Content="לצמצם גם את הרווח הריק (מפעיל מחדש את Explorer)"
                                                  Checked="ReduceGapCheckBox_CheckedChanged" Unchecked="ReduceGapCheckBox_CheckedChanged" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="הפעלה מחדש של Explorer בפתיחת התוכנה ובסגירתה" Margin="0,10,0,3" />
                                        <ComboBox x:Name="ExplorerAutoLaunchModeComboBox" Width="220" HorizontalAlignment="Left" SelectionChanged="ExplorerAutoLaunchModeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="לשאול בכל פעם - ברירת מחדל" />
                                            <ComboBoxItem Content="לא להפעיל" />
                                            <ComboBoxItem Content="להפעיל אוטומטית" />
                                        </ComboBox>
                                    </StackPanel>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>
                            <!-- כלי עזר ידני שתמיד זמין, בלי תלות בהגדרות ההסתרה שלמעלה. -->
                            <controls:SettingsCard Glyph="&#xE72C;" Header="הפעלה מחדש של Explorer עכשיו"
                                                   Description="למקרה שההפעלה מחדש לא קרתה אוטומטית ורוצים להחיל את הצמצום מיד">
                                <Button x:Name="LaunchExplorerNowButton" Content="הפעלה מחדש" Style="{StaticResource ActionButtonStyle}" Margin="0" Click="LaunchExplorerNowButton_Click" />
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="מראה" />
                            <ToggleButton x:Name="FontColorAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE8D2;" Content="גופן וצבע טקסט" />
                            <Border x:Name="FontColorAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="UseCustomFontCheckBox" Content="גופן וגודל מותאמים אישית (במקום חיקוי השעון של Windows)" Checked="UseCustomFontCheckBox_CheckedChanged" Unchecked="UseCustomFontCheckBox_CheckedChanged" />
                                    <Grid Margin="26,4,0,0" MaxWidth="420" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="גופן" />
                                            <TextBox x:Name="FontFamilyTextBox" MinWidth="200" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="גודל" />
                                            <TextBox x:Name="FontSizeTextBox" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox x:Name="UseCustomColorCheckBox" Content="צבע טקסט מותאם אישית (במקום התאמה אוטומטית לערכת הנושא)" Margin="0,14,0,4" Checked="UseCustomColorCheckBox_CheckedChanged" Unchecked="UseCustomColorCheckBox_CheckedChanged" />
                                    <controls:ColorPickerControl x:Name="TextColorPicker" Margin="26,0,0,0" />
                                </StackPanel>
                            </Border>

                            <ToggleButton x:Name="BackgroundAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE790;" Content="רקע הוידג'ט" />
                            <Border x:Name="BackgroundAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="כברירת מחדל הוידג'ט שקוף ומוצג רק הטקסט, כמו שורת המשימות עצמה. אפשר לקבוע כאן צבע רקע ורמת שקיפות." />
                                    <CheckBox x:Name="UseCustomBackgroundCheckBox" Content="צבע רקע מותאם אישית" Checked="UseCustomBackgroundCheckBox_CheckedChanged" Unchecked="UseCustomBackgroundCheckBox_CheckedChanged" />
                                    <controls:ColorPickerControl x:Name="BackgroundColorPicker" Margin="26,0,0,0" />
                                </StackPanel>
                            </Border>

                            <ToggleButton x:Name="BorderAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE91B;" Content="קו מתאר לוידג'ט" />
                            <Border x:Name="BorderAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="מסגרת דקה סביב הוידג'ט - שימושית בעיקר כשהרקע שקוף או בהיר." />
                                    <CheckBox x:Name="UseWidgetBorderCheckBox" Content="קו מתאר"
                                              Checked="UseWidgetBorderCheckBox_CheckedChanged" Unchecked="UseWidgetBorderCheckBox_CheckedChanged" />
                                    <controls:ColorPickerControl x:Name="WidgetBorderColorPicker" Margin="26,0,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="26,8,0,0">
                                        <TextBlock Text="עובי בפיקסלים:" VerticalAlignment="Center" />
                                        <TextBox x:Name="WidgetBorderThicknessTextBox" Width="50" Margin="8,0,0,0" TextAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel></Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- עמוד 2: לוח עברי ומועדים -->
                <TabItem Header="לוח עברי ומועדים" Tag="לוח ארץ ישראל או חו&quot;ל, מנהג הקהילה, ואילו מועדים להציג">
                    <ScrollViewer x:Name="CalendarTabScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960" /></Grid.ColumnDefinitions><StackPanel Margin="28,0,32,28">
                            <controls:SettingsCard Glyph="&#xE909;" Header="לוח המועדים" Keywords="ישראל חו&quot;ל תפוצות גלויות יום טוב שני פרשה"
                                                   Description="קובע את ימי החג, יום טוב שני של גלויות ופרשת השבוע">
                                <ComboBox x:Name="HolidayRegionComboBox" MinWidth="220" SelectionChanged="HolidaySettingControl_Changed">
                                    <ComboBoxItem Content="אוטומטי לפי המיקום" />
                                    <ComboBoxItem Content="ארץ ישראל" />
                                    <ComboBoxItem Content="חוץ לארץ" />
                                </ComboBox>
                                <controls:SettingsCard.Details>
                                    <TextBlock x:Name="HolidayRegionStatusText" Style="{StaticResource DescriptionText}" Margin="0" />
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE734;" Header="פורים" Keywords="שושן פורים ירושלים מוקפות חומה המשולש"
                                                   Description="בירושלים ובערים מוקפות חומה חוגגים שושן פורים, ולפעמים גם פורים המשולש">
                                <ComboBox x:Name="PurimModeComboBox" MinWidth="220" SelectionChanged="HolidaySettingControl_Changed">
                                    <ComboBoxItem Content="אוטומטי לפי המיקום" />
                                    <ComboBoxItem Content="פורים בי&quot;ד באדר" />
                                    <ComboBoxItem Content="שושן פורים בט&quot;ו באדר" />
                                </ComboBox>
                                <controls:SettingsCard.Details>
                                    <TextBlock x:Name="PurimStatusText" Style="{StaticResource DescriptionText}" Margin="0" />
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE82D;" Header="מנהג הקהילה" Keywords="אשכנז ספרד עדות המזרח מנהג סליחות"
                                                   Description="קובע את המועדים שתלויים במנהג - למשל מתי מתחילים לומר סליחות">
                                <ComboBox x:Name="MinhagComboBox" MinWidth="220" SelectionChanged="HolidaySettingControl_Changed">
                                    <ComboBoxItem Content="אשכנז" />
                                    <ComboBoxItem Content="ספרד ועדות המזרח" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE708;" Header="מעבר ליום העברי הבא" Keywords="שקיעה צאת הכוכבים חצות"
                                                   Description="מתי התאריך העברי והמועד המוצגים מתחלפים. לא משפיע על חישוב זמני היום.">
                                <controls:SettingsCard.Details>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="HebrewDayChangeMidnightRadio" GroupName="HebrewDayChangeMode" Content="בחצות (00:00)" Margin="0,4,24,4" />
                                        <RadioButton x:Name="HebrewDayChangeSunsetRadio" GroupName="HebrewDayChangeMode" Content="בשקיעת החמה" Margin="0,4,24,4" />
                                        <RadioButton x:Name="HebrewDayChangeTzeitRadio" GroupName="HebrewDayChangeMode" Content="בצאת הכוכבים" />
                                    </StackPanel>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="אילו מועדים להציג" />
                            <controls:SettingsCard Glyph="&#xE735;" Header="ימים טובים, חול המועד, חנוכה ופורים" Keywords="ראש השנה יום כיפור סוכות פסח שבועות תשעה באב"
                                                   Description="כולל יום כיפור ותשעה באב. מוצגים תמיד.">
                                <TextBlock Text="תמיד מוצג" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE7C1;" Header="צומות" Keywords="צום תענית"
                                                   Description="צום גדליה, עשרה בטבת, תענית אסתר, תענית בכורות וי&quot;ז בתמוז - כולל דחייה והקדמה">
                                <CheckBox x:Name="HolidayShowFastsCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE787;" Header="ראש חודש" Description="כולל ראש חודש של יומיים">
                                <CheckBox x:Name="HolidayShowRoshChodeshCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE823;" Header="ערבי חגים" Keywords="ערב חג"
                                                   Description="ערב ראש השנה, ערב יום כיפור, ערב פסח, ערב חנוכה, ערב תשעה באב ועוד">
                                <CheckBox x:Name="HolidayShowErevChagCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE734;" Header="מועדים נוספים" Keywords="טו בשבט ל&quot;ג בעומר פסח שני פורים קטן ברכת החמה"
                                                   Description="ט&quot;ו בשבט, פורים קטן, פסח שני, ל&quot;ג בעומר, ט&quot;ו באב וברכת החמה">
                                <CheckBox x:Name="HolidayShowMinorCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE8A5;" Header="שבתות מיוחדות" Keywords="שקלים זכור פרה החודש הגדול חזון נחמו שובה שירה"
                                                   Description="שבת שובה, שירה, שקלים, זכור, פרה, החודש, הגדול, חזון ונחמו">
                                <CheckBox x:Name="HolidayShowSpecialShabbatotCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE8EF;" Header="ספירת העומר" Keywords="עומר"
                                                   Description="מספר היום לעומר. הספירה נאמרת בלילה, ולכן מוצג היום שנספר בלילה הקודם.">
                                <CheckBox x:Name="HolidayShowOmerCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE7E7;" Header="שבת מברכים" Description="השבת שלפני ראש חודש (חוץ מתשרי)">
                                <CheckBox x:Name="HolidayShowMevarchimCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE8F1;" Header="אסרו חג" Description="היום שאחרי סוכות, פסח ושבועות">
                                <CheckBox x:Name="HolidayShowIsruChagCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE7C1;" Header="יום כיפור קטן" Description="ערב ראש חודש (חוץ מתשרי, חשון, טבת ואייר). נהוג בעיקר בקהילות אשכנז.">
                                <CheckBox x:Name="HolidayShowYomKippurKatanCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="לפי מנהג הקהילה" />
                            <controls:SettingsCard x:Name="SelichotCard" Glyph="&#xE720;" Header="תחילת הסליחות" Keywords="סליחות אלול">
                                <CheckBox x:Name="HolidayShowSelichotCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Name="BehabCard" Glyph="&#xE7C1;" Header="תעניות בה&quot;ב" Keywords="שני חמישי שני"
                                                   Description="שני, חמישי ושני אחרי סוכות ואחרי פסח (בחודשים חשון ואייר) - מנהג אשכנז">
                                <CheckBox x:Name="HolidayShowBehabCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard x:Name="CommunityCustomsCard" Glyph="&#xE734;" Header="מימונה" Keywords="מרוקו עדות"
                                                   Description="במוצאי פסח - מנהג יהודי צפון אפריקה">
                                <CheckBox x:Name="HolidayShowCommunityCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="תצוגה" />
                            <controls:SettingsCard Glyph="&#xE8CB;" Header="בוידג'ט: רק המועד העיקרי"
                                                   Description="כשיש כמה מועדים באותו יום, הוידג'ט מציג רק את החשוב מהם. לוח הזמנים ושולחן העבודה מציגים את כולם.">
                                <CheckBox x:Name="HolidayWidgetPrimaryOnlyCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE8EF;" Header="מספר היום" Description="למשל &quot;חנוכה (יום ג')&quot;, &quot;חול המועד פסח (יום ב')&quot; וראש חודש של יומיים">
                                <CheckBox x:Name="HolidayDayNumbersCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="HolidaySettingControl_Changed" Unchecked="HolidaySettingControl_Changed" />
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="תצוגה מקדימה" />
                            <controls:SettingsCard Glyph="&#xE736;" Header="פרשת השבוע" Keywords="פרשה">
                                <TextBlock x:Name="ParashaPreviewText" FontWeight="SemiBold" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE81C;" Header="המועדים הקרובים" Description="לפי ההגדרות שבעמוד הזה, עוד לפני השמירה">
                                <controls:SettingsCard.Details>
                                    <Grid x:Name="UpcomingHolidaysGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>

                            <Border Style="{StaticResource InfoBarStyle}" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,10,0" />
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="ימים לאומיים של מדינת ישראל אינם מוצגים בלוח." />
                                </StackPanel>
                            </Border>
                        </StackPanel></Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- עמוד 3: מיקום וזמני היום -->
                <TabItem Header="מיקום וזמני היום" Tag="המיקום לחישוב הזמנים, שיטת החישוב ותבנית השעה">
                    <ScrollViewer x:Name="ZmanimTabScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960" /></Grid.ColumnDefinitions><StackPanel Margin="28,0,32,28">
                            <!-- הערים נטענות בקוד מתוך LocationPresets, והרוחב מחושב לפי השם הארוך ביותר. -->
                            <controls:SettingsCard Glyph="&#xE80F;" Header="מיקום" Description="זריחה, שקיעה וכל זמני היום מחושבים לפיו" Keywords="עיר יישוב">
                                <ComboBox x:Name="LocationPresetComboBox" SelectionChanged="LocationPresetComboBox_SelectionChanged" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE707;" Header="איתור אוטומטי" Keywords="GPS"
                                                   Description="דורש שירותי מיקום פעילים ב-Windows (הגדרות ← פרטיות ואבטחה ← מיקום)">
                                <Button x:Name="DetectLocationButton" Content="איתור המיקום" Style="{StaticResource ActionButtonStyle}" Margin="0" Click="DetectLocationButton_Click" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE909;" Header="קואורדינטות ואזור זמן" Keywords="קו רוחב אורך גובה Latitude Longitude"
                                                   Description="ניתנים לעריכה כשבוחרים &quot;מותאם אישית&quot; ברשימת המיקומים">
                                <controls:SettingsCard.Details>
                                    <Grid MaxWidth="520" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="קו רוחב (Latitude)" />
                                            <TextBox x:Name="LatitudeTextBox" IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="קו אורך (Longitude)" />
                                            <TextBox x:Name="LongitudeTextBox" IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="גובה מעל פני הים (מטרים)" />
                                            <TextBox x:Name="ElevationTextBox" IsEnabled="False" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="אזור זמן (Windows Time Zone ID)" />
                                            <TextBox x:Name="TimeZoneTextBox" IsEnabled="False" />
                                        </StackPanel>
                                    </Grid>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="זמני היום" />
                            <controls:SettingsCard Glyph="&#xE9E9;" Header="שיטת חישוב עלות השחר וצאת הכוכבים" Keywords="מגן אברהם גר&quot;א 72 דקות זווית">
                                <ComboBox x:Name="ZmanCalculationMethodComboBox" MinWidth="250">
                                    <ComboBoxItem Content="זווית שמש - ברירת מחדל" />
                                    <ComboBoxItem Content="72 דקות זמניות" />
                                </ComboBox>
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE8FD;" Header="אילו זמנים להציג" Keywords="הדלקת נרות שם מותאם"
                                                   Description="בלוח הזמנים וברשימות של עמוד ההתראות. לחיצה על שם של זמן פותחת עריכה.">
                                <controls:SettingsCard.Details>
                                    <StackPanel x:Name="ZmanVisibilityPanel" />
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>
                            <Border Style="{StaticResource InfoBarStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,10,0" />
                                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="הזמנים משוערים לפי חישוב אסטרונומי. להלכה למעשה כדאי להתייעץ עם רב." />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="תאריך ושעה" />
                            <controls:SettingsCard Glyph="&#xE787;" Header="תאריך ושעה ידניים" Keywords="בדיקה"
                                                   Description="במקום התאריך והשעה של המחשב. משפיע על כל התוכנה: הוידג'ט, לוח הזמנים וההתראות.">
                                <CheckBox x:Name="UseManualDateTimeCheckBox" Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="UseManualDateTimeCheckBox_CheckedChanged" Unchecked="UseManualDateTimeCheckBox_CheckedChanged" />
                                <controls:SettingsCard.Details>
                                    <StackPanel x:Name="ManualDateTimePanel" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="תאריך" />
                                            <DatePicker x:Name="ManualDatePicker" Width="170" />
                                        </StackPanel>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="שעה (HH:mm)" />
                                            <TextBox x:Name="ManualTimeTextBox" Width="110" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE917;" Header="תבנית שעה">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TimeFormat24Radio" GroupName="TimeFormat" Content="24 שעות (13:05)" Margin="0,4,20,4" />
                                    <RadioButton x:Name="TimeFormat12Radio" GroupName="TimeFormat" Content="12 שעות (1:05 PM)" />
                                </StackPanel>
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE916;" Header="הצגת שניות" Description="בוידג'ט ובתצוגה על שולחן העבודה בלבד">
                                <CheckBox x:Name="ShowSecondsCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                            </controls:SettingsCard>
                        </StackPanel></Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- עמוד 4: התראות -->
                <TabItem Header="התראות" Tag="תזכורות לפני זמני היום, בהודעה צפה ובקול">
                    <ScrollViewer x:Name="NotificationsTabScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960" /></Grid.ColumnDefinitions><StackPanel Margin="28,0,32,28">
                            <controls:SettingsCard Glyph="&#xEA8F;" Header="התראות על זמני היום">
                                <CheckBox x:Name="NotificationsEnabledCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="NotificationsEnabledCheckBox_CheckedChanged" Unchecked="NotificationsEnabledCheckBox_CheckedChanged" />
                            </controls:SettingsCard>

                            <StackPanel x:Name="NotificationsDetailsPanel">
                                <controls:SettingsCard Glyph="&#xE708;" Header="השתקה בשבתות ובחגים" Keywords="שבת יום טוב"
                                                       Description="ביום השבת והחג עצמו. ערב שבת וערב חג, כולל התראת הדלקת נרות, לא מושתקים.">
                                    <CheckBox x:Name="DisableNotificationsOnShabbatCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                                </controls:SettingsCard>

                                <TextBlock Style="{StaticResource GroupHeader}" Text="אופן ההתראה" />
                                <controls:SettingsCard Glyph="&#xE8BD;" Header="הודעה צפה" Description="חלונית קטנה שמופיעה על המסך">
                                    <CheckBox x:Name="NotificationShowPopupCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="NotificationShowPopupCheckBox_CheckedChanged" Unchecked="NotificationShowPopupCheckBox_CheckedChanged" />
                                </controls:SettingsCard>

                                <!-- מוצג רק כשההודעה הצפה פעילה -->
                                <ToggleButton x:Name="ToastSettingsAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE771;"
                                              Content="הגדרות ההודעה הצפה" Visibility="Collapsed" />
                                <Border x:Name="ToastSettingsAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="היכן תופיע ההודעה" />
                                        <StackPanel Orientation="Horizontal">
                                            <!-- "מעל הוידג'ט" עוקב אחרי המיקום הנוכחי של הוידג'ט; השאר קבועים ביחס למסך. -->
                                            <ComboBox x:Name="NotificationToastPositionComboBox" HorizontalAlignment="Left" SelectionChanged="NotificationToastPositionComboBox_SelectionChanged">
                                                <ComboBoxItem Content="מעל הוידג'ט" />
                                                <ComboBoxItem Content="מרכז המסך" />
                                                <ComboBoxItem Content="פינה שמאלית עליונה" />
                                                <ComboBoxItem Content="פינה ימנית עליונה" />
                                                <ComboBoxItem Content="פינה שמאלית תחתונה" />
                                                <ComboBoxItem Content="פינה ימנית תחתונה" />
                                                <ComboBoxItem Content="מיקום מותאם אישית" />
                                            </ComboBox>
                                            <StackPanel x:Name="NotificationToastCustomPositionPanel" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBox x:Name="NotificationToastCustomXTextBox" Width="64" TextAlignment="Center" />
                                                <TextBlock Text="Y:" VerticalAlignment="Center" Margin="12,0,4,0" />
                                                <TextBox x:Name="NotificationToastCustomYTextBox" Width="64" TextAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="NotificationToastCustomPositionExplanationText" Style="{StaticResource DescriptionText}" Margin="0,4,0,0" Visibility="Collapsed"
                                                   Text="המיקום בפיקסלים: X - מרחק מהקצה השמאלי של המסך, Y - מרחק מהקצה העליון." />

                                        <WrapPanel Margin="0,12,0,0">
                                            <StackPanel Margin="0,0,24,8">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="רקע" />
                                                <ComboBox x:Name="NotificationToastBackgroundComboBox" Width="110" MinWidth="110" HorizontalAlignment="Left">
                                                    <ComboBoxItem Content="כהה" />
                                                    <ComboBoxItem Content="בהיר" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,24,8">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="משך תצוגה (שניות)" />
                                                <TextBox x:Name="NotificationToastDurationTextBox" Width="80" HorizontalAlignment="Left" TextAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="משך הנודניק (דקות)" />
                                                <TextBox x:Name="SnoozeDurationMinutesTextBox" Width="80" HorizontalAlignment="Left" TextAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <controls:SettingsCard Glyph="&#xE767;" Header="התראה קולית" Keywords="צליל הקראה קובץ שמע">
                                    <CheckBox x:Name="NotificationPlaySoundCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="NotificationPlaySoundCheckBox_CheckedChanged" Unchecked="NotificationPlaySoundCheckBox_CheckedChanged" />
                                    <controls:SettingsCard.Details>
                                        <StackPanel x:Name="NotificationSoundDetailsPanel">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="סוג ההתראה הקולית" />
                                            <WrapPanel>
                                                <ComboBox x:Name="NotificationSoundSourceComboBox" Width="170" Margin="0,2,8,2" SelectionChanged="NotificationSoundSourceComboBox_SelectionChanged">
                                                    <ComboBoxItem Content="הקראה קולית" />
                                                    <ComboBoxItem Content="צליל קבוע מתוך רשימה" />
                                                    <ComboBoxItem Content="קובץ שמע מהמחשב" />
                                                </ComboBox>

                                                <ComboBox x:Name="NotificationVoiceKitComboBox" Width="150" Margin="0,2,8,2" DropDownOpened="NotificationVoiceKitComboBox_DropDownOpened" />

                                                <ComboBox x:Name="NotificationFixedSoundComboBox" Width="150" Margin="0,2,8,2">
                                                    <ComboBoxItem Content="צליל 1" />
                                                    <ComboBoxItem Content="צליל 2" />
                                                    <ComboBoxItem Content="צליל 3" />
                                                    <ComboBoxItem Content="צליל 4" />
                                                    <ComboBoxItem Content="צליל 5" />
                                                    <ComboBoxItem Content="צליל 6" />
                                                    <ComboBoxItem Content="צליל 7" />
                                                    <ComboBoxItem Content="צליל 8" />
                                                    <ComboBoxItem Content="צליל 9" />
                                                    <ComboBoxItem Content="צליל 10" />
                                                </ComboBox>

                                                <StackPanel x:Name="NotificationCustomSoundDetailsPanel" Orientation="Horizontal">
                                                    <TextBox x:Name="NotificationCustomSoundPathTextBox" Width="190" IsReadOnly="True" Margin="0,0,6,0" />
                                                    <Button x:Name="NotificationBrowseSoundButton" Content="עיון..." Style="{StaticResource ActionButtonStyle}" MinWidth="70" Margin="0" Click="NotificationBrowseSoundButton_Click" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </controls:SettingsCard.Details>
                                </controls:SettingsCard>

                                <TextBlock Style="{StaticResource GroupHeader}" Text="על אילו זמנים להתריע" />
                                <controls:SettingsCard Glyph="&#xE823;" Header="זמנים וזמן התראה" Keywords="נסוי דקות לפני צליל מיוחד"
                                                       Description="זמן לפני בתבנית שעות:דקות (למשל 0:10). צליל מיוחד לזמן מסוים גובר על הצליל הכללי. &quot;נסוי&quot; מציג את ההתראה כפי שתיראה.">
                                    <controls:SettingsCard.Details>
                                        <StackPanel x:Name="ZmanimRulesPanel" Grid.IsSharedSizeScope="True" />
                                    </controls:SettingsCard.Details>
                                </controls:SettingsCard>

                                <TextBlock Style="{StaticResource GroupHeader}" Text="התראות מתקדמות" />
                                <controls:SettingsCard Glyph="&#xE9E9;" Header="כמה התראות לאותו זמן" Keywords="מתקדם נוספת"
                                                       Description="למשל 40 דקות לפני, 30 דקות לפני ו-5 דקות לפני אותו זמן. לכל התראה תצוגה וצליל משלה.">
                                    <controls:SettingsCard.Details>
                                        <StackPanel x:Name="NotificationsAdvancedPanel">
                                            <StackPanel x:Name="AdvancedNotificationRulesPanel" />

                                            <Button x:Name="AddAdvancedNotificationButton" Content="+ הוספת התראה" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddAdvancedNotificationButton_Click" />

                                            <!-- עורך התראה, משותף להוספה ולעריכה -->
                                            <Border x:Name="AdvancedRuleEditorBorder" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,12"
                                                    Background="{DynamicResource WindowBackgroundBrush}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock x:Name="AdvancedRuleEditorTitle" Text="התראה חדשה" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,10" />

                                                    <WrapPanel>
                                                        <StackPanel Margin="0,0,16,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="על איזה זמן" />
                                                            <ComboBox x:Name="AdvancedRuleZmanComboBox" MinWidth="220" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="זמן לפני (שעות:דקות)" />
                                                            <TextBox x:Name="AdvancedRuleMinutesTextBox" Width="90" HorizontalAlignment="Left" TextAlignment="Center" ToolTip="למשל 0:10 או 1:15" />
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="מה תכלול ההתראה" Margin="0,6,0,3" />
                                                    <WrapPanel>
                                                        <CheckBox x:Name="AdvancedRuleShowPopupCheckBox" Content="הודעה צפה" Margin="0,4,16,4" Checked="AdvancedRuleShowPopupCheckBox_CheckedChanged" Unchecked="AdvancedRuleShowPopupCheckBox_CheckedChanged" />
                                                        <StackPanel x:Name="AdvancedRuleToastDurationPanel" Orientation="Horizontal">
                                                            <TextBlock Text="משך תצוגה (שניות):" VerticalAlignment="Center" />
                                                            <TextBox x:Name="AdvancedRuleToastDurationTextBox" Width="56" Margin="6,0,0,0" TextAlignment="Center" />
                                                            <TextBlock Text="רקע:" VerticalAlignment="Center" Margin="14,0,0,0" />
                                                            <ComboBox x:Name="AdvancedRuleToastBackgroundComboBox" Width="90" MinWidth="90" Margin="6,0,0,0">
                                                                <ComboBoxItem Content="כהה" />
                                                                <ComboBoxItem Content="בהיר" />
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <CheckBox x:Name="AdvancedRulePlaySoundCheckBox" Content="התראה קולית" Margin="0,8,0,0" Checked="AdvancedRulePlaySoundCheckBox_CheckedChanged" Unchecked="AdvancedRulePlaySoundCheckBox_CheckedChanged" />

                                                    <StackPanel x:Name="AdvancedRuleSoundDetailsPanel" Margin="26,4,0,0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="סוג ההתראה הקולית" />
                                                        <WrapPanel>
                                                            <ComboBox x:Name="AdvancedRuleSoundSourceComboBox" Width="170" Margin="0,2,8,2" SelectionChanged="AdvancedRuleSoundSourceComboBox_SelectionChanged">
                                                                <ComboBoxItem Content="הקראה קולית" />
                                                                <ComboBoxItem Content="צליל קבוע מתוך רשימה" />
                                                                <ComboBoxItem Content="קובץ שמע מהמחשב" />
                                                            </ComboBox>

                                                            <ComboBox x:Name="AdvancedRuleVoiceKitComboBox" Width="150" Margin="0,2,8,2" DropDownOpened="AdvancedRuleVoiceKitComboBox_DropDownOpened" />

                                                            <ComboBox x:Name="AdvancedRuleFixedSoundComboBox" Width="150" Margin="0,2,8,2">
                                                                <ComboBoxItem Content="צליל 1" />
                                                                <ComboBoxItem Content="צליל 2" />
                                                                <ComboBoxItem Content="צליל 3" />
                                                                <ComboBoxItem Content="צליל 4" />
                                                                <ComboBoxItem Content="צליל 5" />
                                                                <ComboBoxItem Content="צליל 6" />
                                                                <ComboBoxItem Content="צליל 7" />
                                                                <ComboBoxItem Content="צליל 8" />
                                                                <ComboBoxItem Content="צליל 9" />
                                                                <ComboBoxItem Content="צליל 10" />
                                                            </ComboBox>

                                                            <StackPanel x:Name="AdvancedRuleCustomSoundDetailsPanel" Orientation="Horizontal">
                                                                <TextBox x:Name="AdvancedRuleCustomSoundPathTextBox" Width="190" IsReadOnly="True" Margin="0,0,6,0" />
                                                                <Button x:Name="AdvancedRuleBrowseSoundButton" Content="עיון..." Style="{StaticResource ActionButtonStyle}" MinWidth="70" Margin="0" Click="AdvancedRuleBrowseSoundButton_Click" />
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <Grid Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton Grid.Column="0" x:Name="AdvancedRuleTestToggle" Content="נסוי" Style="{StaticResource ToggleActionButtonStyle}" Checked="AdvancedRuleTestToggle_CheckedChanged" Unchecked="AdvancedRuleTestToggle_CheckedChanged" />
                                                        <Button Grid.Column="2" Content="ביטול" Style="{StaticResource ActionButtonStyle}" Margin="0,0,6,0" Click="AdvancedRuleEditorCancelButton_Click" />
                                                        <Button Grid.Column="3" Content="שמירת ההתראה" Style="{StaticResource PrimaryActionButtonStyle}" Margin="0" Click="AdvancedRuleEditorSaveButton_Click" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Details>
                                </controls:SettingsCard>
                            </StackPanel>
                        </StackPanel></Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- עמוד 5: תצוגה על שולחן העבודה -->
                <TabItem Header="שולחן העבודה" Tag="פרטי היום בגדול, ישירות על שולחן העבודה">
                    <ScrollViewer x:Name="DesktopTabScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960" /></Grid.ColumnDefinitions><StackPanel Margin="28,0,32,28">
                            <controls:SettingsCard Glyph="&#xE7F4;" Header="תצוגה על שולחן העבודה"
                                                   Description="Ctrl + גרירה כדי להזיז. לחיצה ימנית פותחת תפריט (הגדרות, כיבוי, אודות).">
                                <CheckBox x:Name="OverlayEnabledCheckBox" Style="{StaticResource ToggleSwitchStyle}" Checked="OverlayEnabledCheckBox_CheckedChanged" Unchecked="OverlayEnabledCheckBox_CheckedChanged" />
                            </controls:SettingsCard>

                            <StackPanel x:Name="OverlayDetailsPanel">
                                <TextBlock Style="{StaticResource GroupHeader}" Text="מיקום" />
                                <controls:SettingsCard Glyph="&#xE8A7;" Header="מיקום על המסך">
                                    <ComboBox x:Name="OverlayPositionComboBox" SelectionChanged="OverlayPositionComboBox_SelectionChanged">
                                        <ComboBoxItem Content="מרכז המסך" />
                                        <ComboBoxItem Content="פינה שמאלית עליונה" />
                                        <ComboBoxItem Content="פינה ימנית עליונה" />
                                        <ComboBoxItem Content="פינה שמאלית תחתונה" />
                                        <ComboBoxItem Content="פינה ימנית תחתונה" />
                                        <ComboBoxItem Content="מיקום מותאם אישית" />
                                    </ComboBox>
                                    <controls:SettingsCard.Details>
                                        <StackPanel>
                                            <!-- מוצג רק במיקום מותאם אישית -->
                                            <StackPanel x:Name="OverlayCustomPositionGrid" Orientation="Horizontal">
                                                <TextBlock Text="X:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBox x:Name="OverlayCustomXTextBox" Width="64" TextAlignment="Center" />
                                                <TextBlock Text="Y:" VerticalAlignment="Center" Margin="12,0,4,0" />
                                                <TextBox x:Name="OverlayCustomYTextBox" Width="64" TextAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="OverlayCustomPositionExplanationText" Style="{StaticResource DescriptionText}" Margin="0,4,0,0" Visibility="Collapsed"
                                                       Text="המיקום בפיקסלים: X - מרחק מהקצה השמאלי של המסך, Y - מרחק מהקצה העליון." />
                                        </StackPanel>
                                    </controls:SettingsCard.Details>
                                </controls:SettingsCard>
                                <controls:SettingsCard Glyph="&#xE72E;" Header="נעילת מיקום" Description="מונעת הזזה בטעות ב-Ctrl + גרירה">
                                    <CheckBox x:Name="LockOverlayPositionCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard Glyph="&#xE718;" Header="תמיד למעלה" Description="מעל כל שאר החלונות">
                                    <CheckBox x:Name="OverlayAlwaysOnTopCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                                </controls:SettingsCard>

                                <TextBlock Style="{StaticResource GroupHeader}" Text="תוכן" />
                                <controls:SettingsCard Glyph="&#xE8CB;" Header="מה להציג ובאיזה סדר" Keywords="שעה פרשה תאריך מועדים סדר"
                                                       Description="סמנו את הפריטים שיוצגו, והחיצים קובעים את הסדר (העליון מוצג ראשון)">
                                    <controls:SettingsCard.Details>
                                        <StackPanel x:Name="OverlayShowOrderPanel" Grid.IsSharedSizeScope="True" />
                                    </controls:SettingsCard.Details>
                                </controls:SettingsCard>

                                <TextBlock Style="{StaticResource GroupHeader}" Text="מראה" />
                                <controls:SettingsCard Glyph="&#xE8D2;" Header="גופן וגודל" Description="משותף לכל הפריטים, אלא אם הותאם לפריט מסוים למטה">
                                    <controls:SettingsCard.Details>
                                        <Grid MaxWidth="420" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="גופן" />
                                                <TextBox x:Name="OverlayFontFamilyTextBox" MinWidth="200" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="גודל" />
                                                <TextBox x:Name="OverlayFontSizeTextBox" TextAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </controls:SettingsCard.Details>
                                </controls:SettingsCard>
                                <controls:SettingsCard Glyph="&#xE790;" Header="צבע טקסט" Description="משותף לכל הפריטים, אלא אם הותאם לפריט מסוים למטה">
                                    <controls:SettingsCard.Details>
                                        <controls:ColorPickerControl x:Name="OverlayColorPicker" />
                                    </controls:SettingsCard.Details>
                                </controls:SettingsCard>

                                <!-- התאמה אישית לכל פריט; רק חלק אחד פתוח בכל רגע - ראו ConfigureAccordionGroup. -->
                                <TextBlock Style="{StaticResource GroupHeader}" Text="התאמה אישית לכל פריט" />
                                <ToggleButton x:Name="OverlayTimeAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE917;" Content="שעה" />
                                <Border x:Name="OverlayTimeAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="OverlayTimeCustomStyleCheckBox" Content="התאמה אישית לפריט זה" Checked="OverlayItemCustomStyleCheckBox_CheckedChanged" Unchecked="OverlayItemCustomStyleCheckBox_CheckedChanged" />
                                        <StackPanel x:Name="OverlayTimeStylePanel" Margin="26,4,0,0">
                                            <Grid MaxWidth="420" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OverlayTimeFontFamilyTextBox" Grid.Column="0" MinWidth="200" Margin="0,2,8,2" />
                                                <TextBox x:Name="OverlayTimeFontSizeTextBox" Grid.Column="1" TextAlignment="Center" />
                                            </Grid>
                                            <controls:ColorPickerControl x:Name="OverlayTimeColorPicker" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ToggleButton x:Name="OverlayDayParashaAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE736;" Content="יום ופרשת שבוע" />
                                <Border x:Name="OverlayDayParashaAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="OverlayDayParashaCustomStyleCheckBox" Content="התאמה אישית לפריט זה" Checked="OverlayItemCustomStyleCheckBox_CheckedChanged" Unchecked="OverlayItemCustomStyleCheckBox_CheckedChanged" />
                                        <StackPanel x:Name="OverlayDayParashaStylePanel" Margin="26,4,0,0">
                                            <Grid MaxWidth="420" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OverlayDayParashaFontFamilyTextBox" Grid.Column="0" MinWidth="200" Margin="0,2,8,2" />
                                                <TextBox x:Name="OverlayDayParashaFontSizeTextBox" Grid.Column="1" TextAlignment="Center" />
                                            </Grid>
                                            <controls:ColorPickerControl x:Name="OverlayDayParashaColorPicker" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ToggleButton x:Name="OverlayHebrewAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE787;" Content="תאריך עברי מלא" />
                                <Border x:Name="OverlayHebrewAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="OverlayHebrewCustomStyleCheckBox" Content="התאמה אישית לפריט זה" Checked="OverlayItemCustomStyleCheckBox_CheckedChanged" Unchecked="OverlayItemCustomStyleCheckBox_CheckedChanged" />
                                        <StackPanel x:Name="OverlayHebrewStylePanel" Margin="26,4,0,0">
                                            <Grid MaxWidth="420" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OverlayHebrewFontFamilyTextBox" Grid.Column="0" MinWidth="200" Margin="0,2,8,2" />
                                                <TextBox x:Name="OverlayHebrewFontSizeTextBox" Grid.Column="1" TextAlignment="Center" />
                                            </Grid>
                                            <controls:ColorPickerControl x:Name="OverlayHebrewColorPicker" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ToggleButton x:Name="OverlayGregorianAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE8BF;" Content="תאריך לועזי" />
                                <Border x:Name="OverlayGregorianAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="OverlayGregorianCustomStyleCheckBox" Content="התאמה אישית לפריט זה" Checked="OverlayItemCustomStyleCheckBox_CheckedChanged" Unchecked="OverlayItemCustomStyleCheckBox_CheckedChanged" />
                                        <StackPanel x:Name="OverlayGregorianStylePanel" Margin="26,4,0,0">
                                            <Grid MaxWidth="420" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OverlayGregorianFontFamilyTextBox" Grid.Column="0" MinWidth="200" Margin="0,2,8,2" />
                                                <TextBox x:Name="OverlayGregorianFontSizeTextBox" Grid.Column="1" TextAlignment="Center" />
                                            </Grid>
                                            <controls:ColorPickerControl x:Name="OverlayGregorianColorPicker" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <ToggleButton x:Name="OverlayHolidayAccordionHeader" Style="{StaticResource AccordionHeaderStyle}" Tag="&#xE734;" Content="מועדים" />
                                <Border x:Name="OverlayHolidayAccordionContent" Style="{StaticResource AccordionContentStyle}">
                                    <StackPanel>
                                        <CheckBox x:Name="OverlayHolidayCustomStyleCheckBox" Content="התאמה אישית לפריט זה" Checked="OverlayItemCustomStyleCheckBox_CheckedChanged" Unchecked="OverlayItemCustomStyleCheckBox_CheckedChanged" />
                                        <StackPanel x:Name="OverlayHolidayStylePanel" Margin="26,4,0,0">
                                            <Grid MaxWidth="420" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OverlayHolidayFontFamilyTextBox" Grid.Column="0" MinWidth="200" Margin="0,2,8,2" />
                                                <TextBox x:Name="OverlayHolidayFontSizeTextBox" Grid.Column="1" TextAlignment="Center" />
                                            </Grid>
                                            <controls:ColorPickerControl x:Name="OverlayHolidayColorPicker" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel></Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- עמוד 6: כללי -->
                <TabItem Header="כללי" Tag="הפעלה עם Windows, מראה החלון, עדכונים ושחזור">
                    <ScrollViewer x:Name="GeneralTabScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960" /></Grid.ColumnDefinitions><StackPanel Margin="28,0,32,28">
                            <controls:SettingsCard Glyph="&#xE7E8;" Header="הפעלה עם עליית Windows" Keywords="אתחול">
                                <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE790;" Header="מראה חלון ההגדרות" Keywords="כהה בהיר ערכת נושא">
                                <ComboBox x:Name="SettingsPanelAppearanceComboBox" MinWidth="140" SelectionChanged="SettingsPanelAppearanceComboBox_SelectionChanged">
                                    <ComboBoxItem Content="בהיר" />
                                    <ComboBoxItem Content="כהה" />
                                </ComboBox>
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="עדכונים" />
                            <controls:SettingsCard Glyph="&#xE895;" Header="בדיקת עדכונים אוטומטית" Description="פעם ביום, ברקע">
                                <CheckBox x:Name="CheckForUpdatesCheckBox" Style="{StaticResource ToggleSwitchStyle}" />
                            </controls:SettingsCard>
                            <controls:SettingsCard Glyph="&#xE72C;" Header="מצב העדכונים" Keywords="גרסה חדשה">
                                <Button x:Name="CheckUpdateNowButton" Content="בדיקה עכשיו" Style="{StaticResource ActionButtonStyle}" Margin="0" Click="CheckUpdateNowButton_Click" />
                                <controls:SettingsCard.Details>
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateStatusText" Text="לא נבדק עדיין בסשן הזה" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        <StackPanel x:Name="UpdateAvailablePanel" Margin="0,10,0,0" Visibility="Collapsed">
                                            <TextBlock x:Name="UpdateAvailableText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="UpdateNowButton" Content="עדכון" Style="{StaticResource PrimaryActionButtonStyle}" Click="UpdateNowButton_Click" />
                                                <Button x:Name="WhatsNewButton" Content="מה חדש בגרסה" Style="{StaticResource ActionButtonStyle}" Click="WhatsNewButton_Click" />
                                            </StackPanel>
                                            <ProgressBar x:Name="UpdateProgressBar" Style="{StaticResource RoundedProgressBarStyle}" Height="10" Margin="0,12,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                            <TextBlock x:Name="UpdateProgressText" Margin="0,4,0,0" FontSize="11.5" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Details>
                            </controls:SettingsCard>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="שחזור" />
                            <controls:SettingsCard Glyph="&#xE777;" Header="שחזור הגדרות ברירת המחדל" Keywords="איפוס"
                                                   Description="מחזיר את כל ההגדרות למצב ההתחלתי">
                                <Button x:Name="RestoreDefaultsButton" Content="שחזור" Style="{StaticResource ActionButtonStyle}" Margin="0" Click="RestoreDefaultsButton_Click" />
                            </controls:SettingsCard>
                        </StackPanel></Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- עמוד 7: אודות -->
                <TabItem Header="אודות" Tag="פרטי התוכנה ומקורות">
                    <ScrollViewer x:Name="AboutTabScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="960" /></Grid.ColumnDefinitions><StackPanel Margin="28,0,32,28">
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20,18">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/app.ico" Width="56" Height="56" VerticalAlignment="Top" />
                                    <StackPanel Margin="18,0,0,0" MaxWidth="560">
                                        <TextBlock x:Name="AboutVersionText" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="פותח ע&quot;י ישראל אמיתי" Margin="0,2,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        <TextBlock Text="וידג'ט תאריך עברי לשורת המשימות: התאריך העברי, היום בשבוע ופרשת השבוע ליד שעון המערכת, חגים ומועדים, וזמני היום ההלכתיים."
                                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,12,0,0">
                                            <Hyperlink x:Name="AboutGitHubLink" Style="{StaticResource LinkTextStyle}" Click="AboutGitHubLink_Click">קוד המקור ב-GitHub</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupHeader}" Text="מקורות ורישיונות" />
                            <controls:SettingsCard Glyph="&#xE787;" Header="לוח השנה, החגים ופרשות השבוע"
                                                   Description="מחושבים בתוכנה עצמה, ונבדקו מול נתוני Hebcal.com (רישיון CC BY 4.0) לשנים 1999-2100" />
                            <controls:SettingsCard Glyph="&#xE706;" Header="חישוב זמני היום"
                                                   Description="מבוסס על KosherJava דרך Yitzchok/Zmanim, מאת אליהו הרשפלד (רישיון LGPL 2.1)" />
                        </StackPanel></Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- סרגל פעולות תחתון -->
        <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource FooterBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,12,24,12">
            <!-- Dock מתהפך ב-RTL: Left מוצג בפועל מימין. -->
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="שמירה" Style="{StaticResource PrimaryActionButtonStyle}" Click="SaveButton_Click" ToolTip="Ctrl+S" />
                    <Button x:Name="ApplyButton" Content="החלה" Style="{StaticResource ActionButtonStyle}" Click="ApplyButton_Click" />
                    <Button x:Name="CancelButton" Content="ביטול" Style="{StaticResource ActionButtonStyle}" Click="CancelButton_Click" />
                    <StackPanel x:Name="UnsavedChangesIndicator" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentForegroundBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="יש שינויים שלא נשמרו" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="ExitApplicationButton" DockPanel.Dock="Right" Content="יציאה מהתוכנה" Style="{StaticResource ActionButtonStyle}" Margin="0" Click="ExitApplicationButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

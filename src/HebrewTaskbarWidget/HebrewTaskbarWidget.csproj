<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>HebrewTaskbarWidget</AssemblyName>
    <RootNamespace>HebrewTaskbarWidget</RootNamespace>

    <!-- מספר גרסה -->
    <Version>0.5.2</Version>
    <AssemblyVersion>0.5.2.0</AssemblyVersion>
    <FileVersion>0.5.2.0</FileVersion>
    <Product>תאריכון</Product>
    <AssemblyTitle>Tarichon - Hebrew Taskbar Widget</AssemblyTitle>
    <Company>Tarichon Project</Company>

    <!-- תמיכה נכונה ב-DPI לכל מסך בנפרד (חשוב למיקום מדוייק ליד השעון) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- סמל התוכנה המקומפלת (קובץ ה-exe עצמו, כפי שמוצג בסייר הקבצים/קיצורי דרך) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- גרסת ה-Windows המינימלית הנתמכת בפועל בזמן ריצה: Windows 10 1809 ומעלה.
         (גרסת ה-Windows SDK שכנגדה מתבצעת ההידור, 10.0.19041.0, כלולה כבר
         במחרוזת ה-TargetFramework למעלה - אין צורך להגדירה כאן שוב.) -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- כלול את קובץ המניפסט בפרוייקט -->
    <None Remove="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <!-- קובץ סמל האפליקציה - משמש גם כ-ApplicationIcon למעלה, וגם כ-Window.Icon
         (Assets/app.ico) בחלונות המוצגות עם מסגרת מערכת (SettingsWindow) -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- תיקיית קבצי ההתראה הקולית (VoiceAnnouncements) - הכללת קובץ ההדרכה
         כ-Content עם CopyToOutputDirectory יוצרת את התיקייה הזו אוטומטית
         בתיקיית הפלט כבר בזמן קימפול התוכנה (ולא רק כשמריצים אותה בפעם
         הראשונה, כפי שהיה קודם) - כך שהתיקייה מוכנה מראש להנחת קבצי שמע. -->
    <Content Include="VoiceAnnouncements\הדרכה להתראות קוליות.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- נדרש עבור System.Windows.Automation (UI Automation) - שמשמש לאיתור
         אמין של כפתור "^" (הצג סמלים מוסתרים) במגש המערכת, כולל ב-Windows 11
         שם חלק ניכר מאזור ההתראות מבוסס XAML ואינו חושף HWND-ים נפרדים לכל
         סמל/כפתור, ולכן חיפוש Win32 גולמי (FindWindowEx) לבדו אינו מספיק
         אמין שם. ראו Services/TaskbarClockLocator.cs.
    -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

</Project>

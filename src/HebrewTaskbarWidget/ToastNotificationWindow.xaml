<Window x:Class="HebrewTaskbarWidget.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="התראת זמן היום"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="False">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard" Completed="FadeOutStoryboard_Completed">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.4" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="ToastBorder"
            Background="#F0202225"
            CornerRadius="10"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="16,12"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="Black" />
        </Border.Effect>

        <Grid>
            <StackPanel Width="240" Margin="0,6,0,0">
                <TextBlock x:Name="TitleText" Foreground="#9A9A9A" FontSize="10.5" FontWeight="SemiBold"
                           TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" Foreground="#E4E4E4" FontSize="12.5" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>

            <Button x:Name="CloseButton"
                    Content="✕"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="20" Height="20"
                    Padding="0"
                    FontSize="11"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseButton_Click"
                    Margin="-6,-8,0,0"
                    ToolTip="סגירה" />

            <Button x:Name="SnoozeButton"
                    Content="🔔"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="20" Height="20"
                    Padding="0"
                    FontSize="11"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SnoozeButton_Click"
                    Margin="0,-8,-6,0"
                    ToolTip="נודניק - הזכר שוב בעוד שתי דקות" />
        </Grid>
    </Border>
</Window>
